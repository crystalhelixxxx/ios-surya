 SweetGPU::start(IOService *provider)
 {
@@ -1260,6 +1359,10 @@ SweetGPU::start(IOService *provider)
 	if (enabled == 8) {
 		sweet_gpu_g4d_setup();          /* standalone context test */
 	}
+	if (enabled == 18) {
+		sweet_gpu_g5_zap_signature();
+		return true;
+	}
 	if (enabled >= 9) {
 		int stage = enabled - 9; /* 9..13 old; 14 g; 15 h; 16 i (RPMH late); 17 j (RPMH EARLY) */
 		if (stage > 8) { stage = 8; }
