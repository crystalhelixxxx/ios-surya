+/* G5: hand the zap shader's header to TrustZone (PAS_INIT_IMAGE, image 13).
+ *
+ * The GPU's "zap shader" is a device-signed image; TrustZone checks its signature
+ * before the 3D core is allowed out of secure mode. The first of the three calls
+ * Linux makes (mdt_loader.c: qcom_mdt_pas_init) only needs the image's header in
+ * memory: the 32-bit ELF header, its program header table, and the block of hashes
+ * and certificates that follows. Nothing of the GPU has to be powered for it, so
+ * this runs as a standalone test (sweetgpu=18) right after the G1 probe.
+ *
+ * The blob arrives as "ZapFW" (--blob ZapFW=a615_zap.mbn), read from the ADT like
+ * GmuFW. TrustZone reads memory, not our caches, so the page is flushed first.
+ */
+static void
+sweet_gpu_g5_zap_signature(void)
+{
+	DTEntry mm;
+	uintptr_t const *reg = NULL;
+	unsigned int dtsize = 0;
+
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess ||
+	    SecureDTGetProperty(mm, "ZapFW", (void const **)&reg, &dtsize) != kSuccess ||
+	    dtsize < 2 * sizeof(uintptr_t)) {
+		printf("SWEET GPU: G5 no /chosen/memory-map ZapFW (pass --blob ZapFW=a615_zap.mbn)\n");
+		return;
+	}
+	uint64_t zap_pa = reg[0], zap_len = reg[1];
+	const uint8_t *zap = (const uint8_t *)ml_static_ptovirt((vm_offset_t)zap_pa);
+	if (zap == NULL || zap_len < 84 || zap_len > PAGE_SIZE) {
+		printf("SWEET GPU: G5 bad ZapFW pa=0x%llx len=0x%llx\n", zap_pa, zap_len);
+		return;
+	}
+
+	/* 32-bit ELF: e_phoff at 28 (u32), e_phnum at 44 (u16), 32 bytes per entry. */
+	uint32_t phoff = (uint32_t)zap[28] | (uint32_t)zap[29] << 8 |
+	    (uint32_t)zap[30] << 16 | (uint32_t)zap[31] << 24;
+	uint32_t phnum = (uint32_t)zap[44] | (uint32_t)zap[45] << 8;
+	printf("SWEET GPU: G5 zap ELF %02x%02x%02x%02x phoff=%u phnum=%u len=0x%llx\n",
+	    zap[0], zap[1], zap[2], zap[3], phoff, phnum, zap_len);
+	if (memcmp(zap, "\177ELF\1", 5) != 0 || phnum < 2 || phnum > 32 ||
+	    (uint64_t)phoff + 32ull * phnum > zap_len) {
+		printf("SWEET GPU: G5 that is not a zap header TrustZone would take\n");
+		return;
+	}
+	uint32_t hashes = (uint32_t)zap[phoff + 32 + 16] | (uint32_t)zap[phoff + 32 + 17] << 8 |
+	    (uint32_t)zap[phoff + 32 + 18] << 16 | (uint32_t)zap[phoff + 32 + 19] << 24;
+	printf("SWEET GPU: G5 by the table: %u bytes of header, then %u of hashes (file 0x%llx)\n",
+	    phoff + 32 * phnum, hashes, zap_len);
+	if ((uint64_t)phoff + 32ull * phnum + hashes != zap_len) {
+		printf("SWEET GPU: G5 the file is not header+hashes alone; passing it anyway\n");
+	}
+
+	vm_offset_t page = 0;
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE,
+	    (kma_flags_t)(KMA_KOBJECT | KMA_ZERO | KMA_DATA), VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPU: G5 no memory for the header page\n");
+		return;
+	}
+	memcpy((void *)page, zap, (vm_size_t)zap_len);
+	to_memory(page, PAGE_SIZE);
+	uint64_t header_pa = kvtophys(page);
+	printf("SWEET GPU: G5 header at pa=0x%llx (0x%llx bytes), asking TrustZone (image %u)\n",
+	    header_pa, zap_len, PAS_GPU);
+
+	uint64_t answer = ~0ull;
+	/* Linux qcom_scm_pas_init_image: 3 args -- pas_id, buffer, its size --
+	 * with a read-write buffer (type 2 at bit 7). */
+	uint64_t arginfo = (3ull | (2ull << 7));
+	int32_t rc = sweet_scm("zap header 64-bit fast", SCM_FAST | SCM_64 | SCM_SIP | SCM_PAS_INIT_IMAGE,
+	    arginfo, PAS_GPU, header_pa, zap_len, &answer);
+	if (rc != 0 || answer != 0) {
+		answer = ~0ull;
+		rc = sweet_scm("zap header 32-bit preemptible", SCM_SIP | SCM_PAS_INIT_IMAGE,
+		    arginfo, PAS_GPU, header_pa, zap_len, &answer);
+	}
+	if (rc == 0 && answer == 0) {
+		printf("SWEET GPU: G5 *** TRUSTZONE ACCEPTS THE ZAP SHADER'S SIGNATURE ***\n");
+	} else {
+		printf("SWEET GPU: G5 TrustZone does not take it: rc=%d answer=0x%llx\n",
+		    rc, (unsigned long long)answer);
+	}
+	printf("SWEET GPU: G5 done\n");
+}
+
